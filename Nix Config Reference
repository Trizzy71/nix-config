## File Reference

### `flake.nix` (Mac)
```nix
{
  description = "Home Manager configuration of tristan";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";  # package source
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";  # use same nixpkgs, no duplication
    };
  };

  outputs = { nixpkgs, home-manager, ... }:
  let
    system = "aarch64-darwin";  # Apple Silicon Mac
    pkgs = nixpkgs.legacyPackages.${system};
  in {
    homeConfigurations."tristan" = home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      modules = [ ./home.nix ];  # points to your user config
    };
  };
}
```

### `flake.nix` (Dell)
```nix
{
  description = "Tristan's NixOS configuration";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { nixpkgs, home-manager, ... }: {
    nixosConfigurations."nixos-test" = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";  # Intel/AMD Dell
      modules = [
        ./configuration.nix     # system config
        home-manager.nixosModules.home-manager
        {
          home-manager.useGlobalPkgs = true;    # share nixpkgs with system
          home-manager.useUserPackages = true;  # install to user profile
          home-manager.users.tristan = import ./home.nix;
        }
      ];
    };
  };
}
```

### `home.nix` Structure Explained
```nix
{ config, pkgs, ... }:   # function arguments provided by home-manager
{
  # WHO YOU ARE
  home.username = "tristan";
  home.homeDirectory = "/Users/tristan";  # /home/tristan on Linux
  home.stateVersion = "25.11";  # NEVER change this

  # UNMANAGED PACKAGES
  # Nix installs these but doesn't configure them
  home.packages = with pkgs; [
    bat fzf btop lf wget nano cmatrix tldr fastfetch
  ];

  # ENVIRONMENT VARIABLES
  # Set every time a shell opens
  home.sessionVariables = {
    EDITOR = "nvim";
  };

  # MANAGED PROGRAMS
  # home-manager installs AND configures these
  programs.zsh = { ... };
  programs.neovim = { ... };
  programs.bat = { ... };
  programs.git = { ... };

  # ALWAYS KEEP THIS
  programs.home-manager.enable = true;
}
```

### `configuration.nix` Key Sections (Dell)
```nix
# FLAKES - enables modern nix features
nix.settings.experimental-features = [ "nix-command" "flakes" ];

# BOOTLOADER - how your system starts
boot.loader.systemd-boot.enable = true;
boot.loader.efi.canTouchEfiVariables = true;

# NETWORKING
networking.hostName = "nixos-test";
networking.networkmanager.enable = true;

# WINDOW MANAGER
services.xserver = {
  enable = true;
  windowManager.qtile.enable = true;
};

# ZSH - must be enabled system-wide when used as login shell
programs.zsh.enable = true;

# USER ACCOUNT
users.users.tristan = {
  isNormalUser = true;
  extraGroups = [ "wheel" "networkmanager" ];
  shell = pkgs.zsh;
};

# SYSTEM PACKAGES - keep minimal, prefer home.nix for user packages
environment.systemPackages = with pkgs; [
  vim
  wget
];
```

